{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Other news",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "date",
      "text_ja",
      "text_en"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "date": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "text_ja": {
        "type": "string",
        "pattern": "\\S"
      },
      "text_en": {
        "type": "string",
        "pattern": "\\S"
      },
      "url": {
        "type": "string",
        "pattern": "^https?://[^\\s/]+[^\\s]*$"
      }
    },
    "additionalProperties": false
  }
}
