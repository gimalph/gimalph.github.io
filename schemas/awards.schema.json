{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic awards",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "award"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "award": {
        "type": "string",
        "pattern": "\\S"
      },
      "award_en": {
        "type": "string",
        "pattern": "\\S"
      },
      "details": {
        "type": "string",
        "pattern": "\\S"
      },
      "details_en": {
        "type": "string",
        "pattern": "\\S"
      },
      "year": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9999
      },
      "month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "url": {
        "type": "string",
        "pattern": "^https?://[^\\s/]+[^\\s]*$"
      },
      "received_on": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "additionalProperties": false,
    "dependentRequired": {
      "month": [
        "year"
      ]
    }
  }
}
